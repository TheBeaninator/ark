# ark.env — where things land. Source this (or export the vars) before any fetch/ or verify/ script. Defaults match the reference build.
export ARK_ROOT=${ARK_ROOT:-/mnt/ark}                       # one big filesystem is fine; the reference build spreads it over six 2 TB drives
export ARK_SOFTWARE=${ARK_SOFTWARE:-$ARK_ROOT/software}     # src/ wheels/ binaries/ debs/ rocm/ containers/ embedded/ docs/
export ARK_MODELS=${ARK_MODELS:-$ARK_ROOT/models}           # <Org__Repo>/{raw,gguf}/
export ARK_HF_ASSETS=${ARK_HF_ASSETS:-$ARK_ROOT/hf-assets}  # <org>/<repo>/  helper weights that mirrored code downloads at first run
export ARK_DATA=${ARK_DATA:-$ARK_ROOT/data}                 # reference/zim reference/genome datasets/ assets/
export ARK_PY=${ARK_PY:-3.12}                               # primary wheel lane (3.13 second GPU lane, 3.14 tools-only as of 2026-09)
export ARK_PIP=${ARK_PIP:-pip}                              # pip of a venv on the primary lane
export HF_HUB_ENABLE_HF_TRANSFER=0
